  }
  .step:hover .step-num { color: rgba(255,77,0,0.18); }
  .step-icon { font-size: 1.8rem; margin-bottom: 14px; display: block; }
  .step-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.15rem; letter-spacing: 0.04em; margin-bottom: 10px; color: var(--text);
  }
  .step-desc { color: var(--muted2); font-size: 0.82rem; line-height: 1.7; }

  /* === TRUST === */
  .trust { position: relative; z-index: 1; padding: 100px 48px; }
  .trust-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 56px; }

  .trust-card {
    border: 1px solid rgba(255,77,0,0.12);
    padding: 40px; background: rgba(18,6,36,0.8);
    position: relative; overflow: hidden;
    transition: border-color 0.3s, transform 0.3s;
  }
  .trust-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0;
    height: 1px; background: var(--grad-main);
    opacity: 0; transition: opacity 0.3s;
  }
  .trust-card:hover { border-color: rgba(255,77,0,0.35); transform: translateY(-4px); }
  .trust-card:hover::before { opacity: 1; }
  .trust-icon { font-size: 2.2rem; margin-bottom: 18px; display: block; }
  .trust-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.2rem; letter-spacing: 0.04em; margin-bottom: 10px;
  }
  .trust-desc { color: var(--muted2); font-size: 0.82rem; line-height: 1.7; }

  /* === WINNERS === */
  .winners {
    position: relative; z-index: 1;
    padding: 100px 48px;
    background: rgba(12,4,28,0.75);
    border-top: 1px solid rgba(255,77,0,0.12);
  }

  .winners-tabs {
    display: flex; gap: 0; margin-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }
  .wtab {
    font-family: 'Bebas Neue', sans-serif; font-size: 0.9rem;
    letter-spacing: 0.1em; color: var(--muted);
    padding: 12px 28px; cursor: pointer;
    background: none; border: none; border-bottom: 2px solid transparent;
    transition: all 0.2s; margin-bottom: -1px;
  }
  .wtab.active { color: var(--fire); border-bottom-color: var(--fire); }
  .wtab:hover:not(.active) { color: var(--muted2); }

  .winners-list { display: flex; flex-direction: column; gap: 2px; background: rgba(255,77,0,0.04); }

  .winner-row {
    background: var(--bg);
    display: grid; grid-template-columns: auto auto 1fr auto auto;
    gap: 20px; align-items: center;
    padding: 20px 36px; transition: background 0.2s;
  }
  .winner-row:hover { background: rgba(18,6,36,0.8); }
  .winner-row:first-child { background: rgba(255,77,0,0.06); }

  .winner-num {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.4rem;
    color: var(--muted); min-width: 36px;
  }
  .winner-row:first-child .winner-num { color: var(--fire); }
  .winner-row:first-child .winner-prize { color: var(--fire); }

  .winner-avatar {
    width: 40px; height: 40px;
    background: var(--grad-main);
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-family: 'Bebas Neue', sans-serif; font-size: 0.9rem; color: #fff;
    flex-shrink: 0; font-weight: 400; letter-spacing: 0.05em;
  }

  .winner-info { display: flex; flex-direction: column; gap: 3px; }
  .winner-name { font-weight: 600; font-size: 0.95rem; }
  .winner-date { color: var(--muted); font-family: 'Fira Code', monospace; font-size: 0.7rem; }
  .winner-prize { font-weight: 700; font-size: 0.9rem; color: var(--muted2); }
  .winner-badge {
    font-family: 'Fira Code', monospace;
    font-size: 0.62rem; letter-spacing: 0.1em;
    padding: 4px 12px;
    border: 1px solid rgba(255,77,0,0.35);
    color: var(--fire);
  }

  /* === CLUB VIP === */
  .club {
    position: relative; z-index: 1;
    padding: 100px 48px; overflow: hidden;
    background: var(--bg);
    border-top: 1px solid var(--border);
  }
  .club::before {
    content: ''; position: absolute; top: -200px; right: -200px;
    width: 800px; height: 800px;
    background: radial-gradient(circle, rgba(232,0,111,0.1) 0%, transparent 65%);
    pointer-events: none;
  }

  .club-grid {
    display: grid; grid-template-columns: 1fr 1.2fr;
    gap: 64px; align-items: center; margin-top: 56px;
  }

  .club-badge-vip {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(232,0,111,0.1);
    border: 1px solid rgba(232,0,111,0.4);
    color: var(--magenta);
    font-family: 'Fira Code', monospace;
    font-size: 0.7rem; letter-spacing: 0.18em;
    text-transform: uppercase; padding: 7px 16px; margin-bottom: 22px;
