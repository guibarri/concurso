  .club-badge-vip::before { content: '★'; font-size: 0.8rem; }

  .club-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.4rem, 4vw, 3.5rem);
    letter-spacing: 0.03em; line-height: 1.0; margin-bottom: 20px;
  }
  .club-title span { color: var(--magenta); }

  .club-desc { color: var(--muted2); font-size: 0.9rem; line-height: 1.8; margin-bottom: 36px; max-width: 430px; }

  .club-perks { display: flex; flex-direction: column; gap: 10px; margin-bottom: 40px; }
  .perk-item {
    display: flex; align-items: center; gap: 14px;
    padding: 14px 18px;
    background: rgba(232,0,111,0.04);
    border: 1px solid rgba(232,0,111,0.12);
    border-left: 3px solid var(--magenta);
    transition: background 0.2s, transform 0.2s;
  }
  .perk-item:hover { background: rgba(232,0,111,0.09); transform: translateX(5px); }
  .perk-icon { font-size: 1.4rem; flex-shrink: 0; }
  .perk-title { font-weight: 700; font-size: 0.88rem; color: var(--text); }
  .perk-sub { font-size: 0.74rem; color: var(--muted); margin-top: 2px; }

  .btn-club {
    background: linear-gradient(135deg, var(--magenta), #7c0060);
    color: #fff; border: none;
    padding: 16px 38px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.05rem; letter-spacing: 0.12em;
    cursor: pointer;
    clip-path: polygon(12px 0%, 100% 0%, calc(100% - 12px) 100%, 0% 100%);
    transition: all 0.3s;
    box-shadow: 0 8px 28px rgba(232,0,111,0.3);
  }
  .btn-club:hover { transform: translateY(-2px); box-shadow: 0 16px 40px rgba(232,0,111,0.45); }

  /* Club tiers */
  .club-tiers { display: flex; flex-direction: column; gap: 2px; background: rgba(232,0,111,0.06); }
  .tier-card {
    background: rgba(18,6,36,0.8); padding: 26px 30px;
    border: 1px solid var(--border); position: relative; overflow: hidden;
    transition: background 0.3s, border-color 0.3s;
  }
  .tier-card:hover { background: rgba(232,0,111,0.04); border-color: rgba(232,0,111,0.25); }
  .tier-card.featured-tier {
    background: linear-gradient(135deg, rgba(232,0,111,0.1) 0%, rgba(255,77,0,0.06) 100%);
    border-color: rgba(232,0,111,0.35);
  }
  .tier-card.featured-tier::before {
    content: 'MÁS POPULAR';
    position: absolute; top: 14px; right: 14px;
    background: var(--magenta); color: #fff;
    font-family: 'Bebas Neue', sans-serif; font-size: 0.7rem;
    letter-spacing: 0.12em; padding: 3px 12px;
    clip-path: polygon(5px 0%, 100% 0%, calc(100% - 5px) 100%, 0% 100%);
  }
  .tier-header { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
  .tier-icon { font-size: 1.8rem; }
  .tier-name {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; letter-spacing: 0.04em;
  }
  .featured-tier .tier-name { color: var(--magenta); }
  .tier-price { margin-left: auto; text-align: right; }
  .tier-price-val {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.4rem;
    background: var(--grad-main);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    display: block;
  }
  .tier-price-lbl { font-family: 'Fira Code', monospace; font-size: 0.6rem; color: var(--muted); letter-spacing: 0.08em; }
  .tier-features { display: flex; flex-wrap: wrap; gap: 8px; }
  .tier-feat {
    font-family: 'Fira Code', monospace; font-size: 0.68rem; color: var(--muted);
    border: 1px solid var(--border); padding: 4px 10px;
    background: rgba(255,255,255,0.02);
  }
  .tier-feat.active { color: var(--magenta); border-color: rgba(232,0,111,0.3); background: rgba(232,0,111,0.06); }

  /* === CTA FINAL === */
  .cta-final {
    position: relative; z-index: 1;
    padding: 120px 48px; text-align: center; overflow: hidden;
  }
  .cta-final::before {
    content: ''; position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 900px; height: 900px;
    background: radial-gradient(circle, rgba(255,77,0,0.12) 0%, transparent 65%);
    pointer-events: none;
  }
  .cta-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(3rem, 6vw, 5.5rem);
    letter-spacing: 0.02em; line-height: 0.95;
    margin-bottom: 24px; position: relative;
  }
  .cta-title span {
    background: var(--grad-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .cta-sub {
    color: var(--muted2); font-size: 1rem;
    margin-bottom: 48px; max-width: 500px;
    margin-left: auto; margin-right: auto; line-height: 1.7;
  }

  /* === CHECKOUT === */
  .checkout-section {
    position: relative; z-index: 1;
    padding: 100px 48px;
    background: rgba(8,3,20,0.85);
    border-top: 1px solid rgba(255,77,0,0.12);
  }
  .checkout-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 1px; background: rgba(255,77,0,0.1);
    margin-top: 56px;
    border: 1px solid rgba(255,77,0,0.14);
    box-shadow: 0 0 80px rgba(255,77,0,0.06);
  }
  .checkout-left { background: rgba(10,4,24,0.85); padding: 48px; }
  .checkout-right { background: rgba(9,4,22,0.85); padding: 48px; display: flex; flex-direction: column; gap: 28px; }

  .checkout-step-label {
    font-family: 'Fira Code', monospace;
    font-size: 0.6rem; letter-spacing: 0.25em;
    text-transform: uppercase; color: var(--fire);
    margin-bottom: 6px; opacity: 0.8;
  }
  .checkout-step-title {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.7rem;
    letter-spacing: 0.04em; margin-bottom: 24px; color: var(--text);
  }

  .checkout-select-prize { display: flex; flex-direction: column; gap: 6px; }
  .checkout-prize-option {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.07);
    padding: 16px 20px;
    display: flex; align-items: center; gap: 14px;
    cursor: pointer; transition: all 0.2s; position: relative;
  }
  .checkout-prize-option::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    width: 3px; background: var(--grad-main);
    transform: scaleY(0); transition: transform 0.25s; transform-origin: bottom;
  }
  .checkout-prize-option:hover { border-color: rgba(255,77,0,0.3); background: rgba(255,77,0,0.04); }
  .checkout-prize-option.selected { border-color: rgba(255,77,0,0.4); background: rgba(255,77,0,0.06); }
  .checkout-prize-option.selected::before { transform: scaleY(1); }
  .cpo-icon { font-size: 1.6rem; }
  .cpo-info { flex: 1; }
  .cpo-name { font-family: 'Bebas Neue', sans-serif; font-size: 1rem; letter-spacing: 0.04em; color: var(--text); }
  .cpo-price { font-family: 'Fira Code', monospace; font-size: 0.7rem; color: var(--muted); margin-top: 3px; }
  .cpo-radio {
    width: 18px; height: 18px;
    border: 1px solid rgba(255,255,255,0.15); border-radius: 50%;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    transition: all 0.2s;
  }
  .checkout-prize-option.selected .cpo-radio {
    border-color: var(--fire); background: var(--fire);
    box-shadow: 0 0 12px rgba(255,77,0,0.5);
  }
  .checkout-prize-option.selected .cpo-radio::after {
    content: ''; width: 6px; height: 6px; background: #fff; border-radius: 50%;
  }

  .checkout-methods { display: flex; flex-direction: column; gap: 8px; margin-top: 32px; }
  .co-method-label {
    font-family: 'Fira Code', monospace;
    font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--fire); margin-bottom: 10px; opacity: 0.8;
  }
  .checkout-method {
    border: 1px solid rgba(255,255,255,0.07); padding: 16px 20px;
    display: flex; align-items: center; gap: 14px;
    cursor: pointer; transition: all 0.2s;
    background: rgba(255,255,255,0.02);
  }
  .checkout-method:hover { border-color: rgba(255,77,0,0.3); background: rgba(255,77,0,0.04); }
  .checkout-method.selected { border-color: rgba(255,77,0,0.45); background: rgba(255,77,0,0.07); }
  .checkout-method.selected::after {
    content: '✓'; margin-left: auto;
    background: var(--grad-main); -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-family: 'Bebas Neue', sans-serif; font-size: 1.1rem;
  }
  .method-icon { font-size: 1.4rem; }
  .method-name { font-family: 'Bebas Neue', sans-serif; font-size: 1rem; letter-spacing: 0.04em; color: var(--text); }
  .method-desc { font-family: 'Fira Code', monospace; font-size: 0.68rem; color: var(--muted); margin-top: 2px; }

  .checkout-summary-card {
    background: linear-gradient(135deg, rgba(255,77,0,0.07) 0%, rgba(232,0,111,0.07) 100%);
    border: 1px solid rgba(255,77,0,0.18);
    padding: 24px; position: relative; overflow: hidden;
  }
  .checkout-summary-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: var(--grad-main);
  }
  .summary-label {
    font-family: 'Fira Code', monospace;
    font-size: 0.6rem; letter-spacing: 0.2em; color: var(--fire);
    text-transform: uppercase; margin-bottom: 10px; opacity: 0.8;
  }
  .summary-prize-name {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem;
    letter-spacing: 0.04em; margin-bottom: 16px; color: var(--text);
  }
  .summary-lines { display: flex; flex-direction: column; }
  .summary-line {
    display: flex; justify-content: space-between;
    padding: 9px 0; border-top: 1px solid rgba(255,255,255,0.05);
    font-size: 0.8rem; color: var(--muted2);
  }
  .summary-line.total-line {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.4rem; letter-spacing: 0.04em;
    color: var(--text); border-top: 1px solid rgba(255,77,0,0.25);
    padding-top: 14px; margin-top: 4px;
  }
  .summary-line.total-line .price-val {
    background: var(--grad-main); -webkit-background-clip: text;
    -webkit-text-fill-color: transparent; font-size: 1.6rem;
  }

  /* Form */
  .co-form-label {
    font-family: 'Fira Code', monospace;
    font-size: 0.6rem; letter-spacing: 0.2em; color: var(--fire);
    text-transform: uppercase; margin-bottom: 10px; opacity: 0.8;
  }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .form-group { display: flex; flex-direction: column; gap: 5px; }
  .form-label { font-family: 'Fira Code', monospace; font-size: 0.6rem; color: var(--muted); letter-spacing: 0.12em; text-transform: uppercase; }
  .form-input {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    color: var(--text); padding: 12px 14px;
    font-family: 'Fira Code', monospace; font-size: 0.84rem;
    outline: none; transition: all 0.2s; width: 100%;
  }
  .form-input::placeholder { color: #2a2840; }
  .form-input:focus {
    border-color: rgba(255,77,0,0.5);
    background: rgba(255,77,0,0.04);
    box-shadow: 0 0 0 3px rgba(255,77,0,0.08);
  }

  /* Trust badges */
  .co-trust { display: flex; gap: 12px; flex-wrap: wrap; }
  .co-trust-badge {
    display: flex; align-items: center; gap: 5px;
    font-family: 'Fira Code', monospace;
    font-size: 0.62rem; color: var(--muted); letter-spacing: 0.06em;
    padding: 5px 10px; border: 1px solid rgba(255,255,255,0.07);
    background: rgba(255,255,255,0.02);
  }
  .co-trust-badge .icon { color: var(--fire); }

  /* Checkout pay button */
  .co-pay-btn {
    width: 100%; background: var(--grad-cool);
    border: none; color: #fff; cursor: pointer;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0; transition: all 0.3s; overflow: hidden; position: relative;
  }
  .co-pay-btn:hover { transform: translateY(-2px); box-shadow: 0 16px 48px rgba(0,102,255,0.4); }
  .co-pay-btn-inner {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 24px; width: 100%; position: relative; z-index: 1;
  }
  .co-pay-left { display: flex; align-items: center; gap: 12px; }
  .co-mp-badge {
    background: rgba(255,255,255,0.2); padding: 5px 10px;
    font-family: 'Bebas Neue', sans-serif; font-size: 0.75rem; letter-spacing: 0.1em;
    border-radius: 2px;
  }
  .co-pay-action { font-family: 'Bebas Neue', sans-serif; font-size: 1rem; letter-spacing: 0.08em; }
  .co-pay-amount {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.4rem; letter-spacing: 0.04em;
  }
  .co-scan-line {
    position: absolute; top: 0; left: -100%; width: 60%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent);
    animation: mpScan 2.5s ease-in-out infinite;
  }
  @keyframes mpScan { 0% { left: -60%; } 100% { left: 160%; } }
  .co-note { font-family: 'Fira Code', monospace; font-size: 0.62rem; color: #444460; text-align: center; margin-top: 8px; letter-spacing: 0.04em; }

  /* === PAYMENT MODAL === */
  .modal-overlay {
    position: fixed; inset: 0;
    background: rgba(3,3,10,0.95);
    backdrop-filter: blur(20px);
    z-index: 1000; display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none; transition: opacity 0.3s;
  }
  .modal-overlay.open { opacity: 1; pointer-events: all; }

  .modal {
    background: rgba(11,4,26,0.97);
    border: 1px solid rgba(255,77,0,0.2);
    width: 100%; max-width: 620px; max-height: 92vh;
    overflow-y: auto; position: relative;
    animation: modalIn 0.4s cubic-bezier(0.16,1,0.3,1) both;
    box-shadow: 0 0 100px rgba(255,77,0,0.1);
  }
  @keyframes modalIn {
    from { opacity: 0; transform: translateY(50px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .modal-corner { position: absolute; width: 18px; height: 18px; z-index: 2; pointer-events: none; }
  .modal-corner.tl { top: -1px; left: -1px; border-top: 2px solid var(--fire); border-left: 2px solid var(--fire); }
  .modal-corner.tr { top: -1px; right: -1px; border-top: 2px solid var(--fire); border-right: 2px solid var(--fire); }
  .modal-corner.bl { bottom: -1px; left: -1px; border-bottom: 2px solid var(--magenta); border-left: 2px solid var(--magenta); }
  .modal-corner.br { bottom: -1px; right: -1px; border-bottom: 2px solid var(--magenta); border-right: 2px solid var(--magenta); }

  .modal-header {
    padding: 26px 30px 20px;
    border-bottom: 1px solid rgba(255,77,0,0.1);
    display: flex; align-items: center; justify-content: space-between;
    background: linear-gradient(135deg, rgba(255,77,0,0.05) 0%, transparent 60%);
  }
  .modal-sys-label {
    font-family: 'Fira Code', monospace;
    font-size: 0.58rem; color: var(--fire);
    letter-spacing: 0.2em; text-transform: uppercase;
    margin-bottom: 5px; opacity: 0.7;
  }
  .modal-title {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.4rem;
    letter-spacing: 0.04em; color: var(--text);
  }
  .modal-close {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    color: var(--muted); width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.9rem; cursor: pointer; transition: all 0.2s;
  }
  .modal-close:hover { border-color: var(--fire); color: var(--fire); background: rgba(255,77,0,0.08); }

  .modal-body { padding: 0; }
  .modal-step {
    display: flex; border-bottom: 1px solid rgba(255,255,255,0.05);
    position: relative;
  }
  .modal-step.last { border-bottom: none; }
  .modal-step-num {
    font-family: 'Bebas Neue', sans-serif; font-size: 0.7rem;
    background: var(--grad-main); -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    letter-spacing: 0.1em;
    writing-mode: vertical-rl;
    padding: 24px 14px; border-right: 1px solid rgba(255,77,0,0.1);
    background-color: rgba(255,77,0,0.02);
