<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VOLTEX — Gran Sorteo Europa 2025</title>

<style>
  /* ============================================
     VOLTEX EUROPA — REDESIGN FUTURISTA VIVO
     Paleta: Naranja volcánico · Magenta neón · Azul cobalto
     Tipografía: Bebas Neue (display) + Space Grotesk (body)
     ============================================ */
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@300;400;500;600;700&family=Fira+Code:wght@300;400;500&display=swap');

  :root {
    --bg:       #0a0514;
    --surface:  #0f0620;
    --card:     #140828;
    --border:   rgba(255,255,255,0.08);

    /* CORE PALETTE — vivos y originales */
    --fire:     #ff4d00;   /* naranja volcánico */
    --magenta:  #e8006f;   /* magenta neón */
    --cobalt:   #0066ff;   /* azul cobalto */
    --gold:     #f5c400;   /* oro vivo */
    --ice:      #00d4ff;   /* cian glacial */

    /* GRADIENTS */
    --grad-main: linear-gradient(135deg, var(--fire), var(--magenta));
    --grad-cool: linear-gradient(135deg, var(--cobalt), var(--ice));
    --grad-full: linear-gradient(135deg, var(--fire), var(--magenta), var(--cobalt));

    --text:     #f5f0ff;
    --muted:    #6a6680;
    --muted2:   #9990bb;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }

  body {
    background:
      radial-gradient(ellipse 80% 60% at 15% 10%,  rgba(255,77,0,0.18)   0%, transparent 55%),
      radial-gradient(ellipse 60% 50% at 85% 5%,   rgba(232,0,111,0.14)  0%, transparent 50%),
      radial-gradient(ellipse 70% 60% at 50% 50%,  rgba(100,0,180,0.12)  0%, transparent 55%),
      radial-gradient(ellipse 80% 60% at 5%  80%,  rgba(0,80,255,0.14)   0%, transparent 55%),
      radial-gradient(ellipse 60% 50% at 90% 90%,  rgba(232,0,111,0.12)  0%, transparent 50%),
      linear-gradient(160deg, #0e0418 0%, #08021a 35%, #04071e 65%, #0a0514 100%);
    background-attachment: fixed;
    color: var(--text);
    font-family: 'Space Grotesk', sans-serif;
    overflow-x: hidden;
  }

  /* === GRAIN TEXTURE OVERLAY === */
  body::after {
    content: '';
    position: fixed; inset: 0; z-index: 9999;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    opacity: 0.35;
  }

  /* === GRID BACKGROUND === */
  body::before {
    content: '';
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(255,77,0,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(100,0,200,0.05) 1px, transparent 1px);
    background-size: 80px 80px;
  }

  /* === NAV === */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 200;
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 48px;
    background: rgba(5,5,13,0.8);
    backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(255,77,0,0.15);
  }

  .logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.8rem;
    letter-spacing: 0.08em;
    color: var(--text);
  }
  .logo span {
    background: var(--grad-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .nav-links { display: flex; gap: 36px; list-style: none; }
  .nav-links a {
    color: var(--muted2);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 0.2s;
    position: relative;
  }
  .nav-links a::after {
    content: ''; position: absolute; bottom: -4px; left: 0;
    width: 0; height: 1px; background: var(--fire);
    transition: width 0.3s;
  }
  .nav-links a:hover { color: var(--text); }
  .nav-links a:hover::after { width: 100%; }

  .nav-cta {
    background: var(--grad-main);
    color: #fff;
    border: none;
    padding: 11px 28px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1rem;
    letter-spacing: 0.12em;
    cursor: pointer;
    clip-path: polygon(10px 0%, 100% 0%, calc(100% - 10px) 100%, 0% 100%);
    transition: all 0.25s;
    box-shadow: 0 0 20px rgba(255,77,0,0.3);
  }
  .nav-cta:hover { transform: translateY(-2px); box-shadow: 0 6px 32px rgba(255,77,0,0.5); }

  /* === TICKER === */
  .ticker {
    position: relative; z-index: 1;
    background: var(--grad-main);
    overflow: hidden; padding: 10px 0;
  }
  .ticker-inner { display: flex; animation: ticker 22s linear infinite; white-space: nowrap; }
  .ticker-item {
    color: #fff;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.9rem;
    letter-spacing: 0.15em;
    padding: 0 36px;
    display: flex; align-items: center; gap: 12px;
    opacity: 0.95;
  }
  .ticker-dot { width: 5px; height: 5px; background: rgba(255,255,255,0.5); border-radius: 50%; }
  @keyframes ticker { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

  /* === HERO === */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex; align-items: center;
    padding: 130px 48px 80px;
    z-index: 1; overflow: hidden;
  }

  /* Diagonal color slabs */
  .hero-slab1 {
    position: absolute; top: -100px; right: -200px;
    width: 700px; height: 700px;
    background: radial-gradient(ellipse, rgba(255,77,0,0.32) 0%, transparent 65%);
    transform: rotate(-25deg);
    pointer-events: none;
  }
  .hero-slab2 {
    position: absolute; bottom: -200px; left: -100px;
    width: 600px; height: 600px;
    background: radial-gradient(ellipse, rgba(232,0,111,0.26) 0%, transparent 65%);
    pointer-events: none;
  }
  .hero-slab3 {
    position: absolute; top: 40%; right: 5%;
    width: 400px; height: 400px;
    background: radial-gradient(ellipse, rgba(0,102,255,0.22) 0%, transparent 65%);
    pointer-events: none;
  }

  .hero-content { max-width: 760px; position: relative; z-index: 2; }

  .hero-badge {
    display: inline-flex; align-items: center; gap: 10px;
    border: 1px solid var(--fire);
    color: var(--fire);
    font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase;
    padding: 7px 18px; margin-bottom: 28px;
    animation: fadeUp 0.7s ease both;
    background: rgba(255,77,0,0.06);
  }
  .hero-badge::before {
    content: ''; width: 7px; height: 7px;
    background: var(--fire); border-radius: 50%;
    animation: pulse 1.8s infinite;
    box-shadow: 0 0 8px var(--fire);
  }
  @keyframes pulse {
    0%,100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.6); }
  }

  .hero h1 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(4rem, 9vw, 8rem);
    line-height: 0.88;
    letter-spacing: 0.02em;
    margin-bottom: 28px;
    animation: fadeUp 0.7s 0.1s ease both;
  }
  .hero h1 .l1 { display: block; color: var(--text); }
  .hero h1 .l2 {
    display: block;
    background: var(--grad-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero h1 .l3 {
    display: block;
    color: transparent;
    -webkit-text-stroke: 2px var(--gold);
    filter: drop-shadow(0 0 12px rgba(245,196,0,0.4));
  }

  .hero-sub {
    color: var(--muted2);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 500px;
    margin-bottom: 40px;
    font-weight: 400;
    animation: fadeUp 0.7s 0.2s ease both;
  }

  .hero-actions {
    display: flex; gap: 16px; align-items: center;
    animation: fadeUp 0.7s 0.3s ease both;
    flex-wrap: wrap;
  }

  .btn-primary {
    background: var(--grad-main);
    color: #fff; border: none;
    padding: 18px 40px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem; letter-spacing: 0.12em;
    cursor: pointer;
    clip-path: polygon(14px 0%, 100% 0%, calc(100% - 14px) 100%, 0% 100%);
    transition: all 0.3s;
    box-shadow: 0 8px 32px rgba(255,77,0,0.35);
    position: relative; overflow: hidden;
  }
  .btn-primary::after {
    content: ''; position: absolute; inset: 0;
    background: rgba(255,255,255,0.15);
    transform: translateX(-100%) skewX(-20deg);
    transition: transform 0.5s;
  }
  .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 16px 48px rgba(255,77,0,0.5); }
  .btn-primary:hover::after { transform: translateX(200%) skewX(-20deg); }

  .btn-ghost {
    color: var(--muted2); font-size: 0.88rem; font-weight: 500;
    text-decoration: none;
    display: flex; align-items: center; gap: 8px;
    transition: color 0.2s; letter-spacing: 0.06em;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 2px;
  }
  .btn-ghost:hover { color: var(--text); border-color: var(--fire); }
  .btn-ghost .arrow { transition: transform 0.2s; }
  .btn-ghost:hover .arrow { transform: translateX(5px); }

  .hero-pay-note {
    margin-top: 20px; font-size: 0.78rem; color: var(--muted);
    display: flex; align-items: center; gap: 8px;
    animation: fadeUp 0.7s 0.4s ease both;
  }
  .hero-pay-note span { color: var(--ice); font-weight: 600; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* === STATS BAR === */
  .stats-bar {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: repeat(4,1fr);
    border-top: 1px solid rgba(255,77,0,0.2);
    border-bottom: 1px solid rgba(255,77,0,0.2);
    background: rgba(12,4,28,0.75);
    overflow: hidden;
  }
  .stats-bar::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--grad-main);
  }
  .stat-item {
    padding: 32px 40px;
    border-right: 1px solid var(--border);
    position: relative; transition: background 0.3s;
  }
  .stat-item:last-child { border-right: none; }
  .stat-item:hover { background: rgba(18,6,36,0.8); }
  .stat-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.6rem; letter-spacing: 0.04em;
    display: block; line-height: 1;
    background: var(--grad-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .stat-label {
    font-size: 0.72rem; font-weight: 500;
    color: var(--muted2);
    letter-spacing: 0.1em; text-transform: uppercase;
    margin-top: 6px; display: block;
  }

  /* === SECTION HEADERS === */
  .section-header {
    display: flex; align-items: baseline;
    justify-content: space-between; margin-bottom: 56px;
  }
  .section-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    letter-spacing: 0.04em;
    color: var(--text);
  }
  .section-title span {
    background: var(--grad-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .section-tag {
    font-family: 'Fira Code', monospace;
    font-size: 0.72rem; color: var(--fire);
    letter-spacing: 0.1em; opacity: 0.8;
    border: 1px solid rgba(255,77,0,0.25);
    padding: 5px 12px;
  }

  /* === FEATURED PRIZE === */
  .featured {
    position: relative; z-index: 1;
    padding: 100px 48px;
  }

  .prize-hero-card {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 1px solid rgba(255,77,0,0.2);
    overflow: hidden; position: relative;
    box-shadow: 0 0 80px rgba(255,77,0,0.08);
  }

  .prize-hero-visual {
    background: rgba(18,6,36,0.8);
    display: flex; align-items: center; justify-content: center;
    padding: 80px; position: relative; overflow: hidden; min-height: 520px;
  }
  .prize-hero-visual::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(255,77,0,0.18) 0%, rgba(232,0,111,0.12) 40%, transparent 70%);
  }
  .prize-hero-visual::after {
    content: ''; position: absolute;
    top: 0; left: 0; right: 0; height: 3px;
    background: var(--grad-main);
  }

  .prize-icon-big {
    font-size: 9rem; position: relative; z-index: 1;
    animation: float 5s ease-in-out infinite;
    filter: drop-shadow(0 0 50px rgba(255,77,0,0.6));
  }
  @keyframes float {
    0%,100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-22px) rotate(2deg); }
  }

  .prize-corner-tag {
    position: absolute; top: 20px; right: 20px;
    background: var(--grad-main);
    color: #fff; font-family: 'Bebas Neue', sans-serif;
    font-size: 0.85rem; letter-spacing: 0.1em;
    padding: 5px 16px;
    clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);
  }

  .prize-hero-info {
    background: rgba(18,6,36,0.8);
    padding: 56px;
    display: flex; flex-direction: column; justify-content: space-between;
    border-left: 1px solid rgba(255,77,0,0.15);
  }

  .prize-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.6rem; letter-spacing: 0.03em; line-height: 1.05;
    margin-bottom: 14px; color: var(--text);
  }
  .prize-desc { color: var(--muted2); font-size: 0.9rem; line-height: 1.7; margin-bottom: 32px; }

  .prize-specs {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 10px; margin-bottom: 36px;
  }
  .spec-item {
    background: rgba(12,4,28,0.75);
    border: 1px solid rgba(255,77,0,0.15);
    border-left: 3px solid var(--fire);
    padding: 14px 16px;
    transition: border-color 0.2s;
  }
  .spec-item:hover { border-color: rgba(255,77,0,0.4); }
  .spec-val {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.3rem; letter-spacing: 0.05em;
    background: var(--grad-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: block;
  }
  .spec-key {
    font-family: 'Fira Code', monospace;
    font-size: 0.62rem; color: var(--muted);
    letter-spacing: 0.1em; text-transform: uppercase;
    display: block; margin-top: 3px;
  }

  /* Countdown */
  .countdown-block { margin-bottom: 32px; }
  .countdown-label {
    font-family: 'Fira Code', monospace;
    font-size: 0.62rem; color: var(--fire);
    letter-spacing: 0.18em; text-transform: uppercase;
    margin-bottom: 14px; display: block;
  }
  .countdown { display: flex; gap: 14px; align-items: center; }
  .cd-unit { text-align: center; }
  .cd-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.2rem; letter-spacing: 0.05em;
    display: block; line-height: 1;
    background: rgba(18,6,36,0.8);
    border: 1px solid rgba(255,77,0,0.25);
    padding: 8px 16px; min-width: 64px;
    color: var(--text);
    box-shadow: inset 0 0 12px rgba(255,77,0,0.06);
  }
  .cd-lbl {
    font-family: 'Fira Code', monospace;
    font-size: 0.58rem; color: var(--muted);
    text-transform: uppercase; letter-spacing: 0.12em;
    margin-top: 6px; display: block;
  }
  .cd-sep { font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; color: var(--fire); margin-top: -16px; }

  /* Ticket selector */
  .ticket-selector { display: flex; gap: 8px; margin-bottom: 24px; flex-wrap: wrap; }
  .ticket-opt {
    background: rgba(12,4,28,0.75);
    border: 1px solid rgba(255,77,0,0.2);
    color: var(--muted2);
    padding: 10px 20px;
    font-family: 'Fira Code', monospace; font-size: 0.8rem;
    cursor: pointer; transition: all 0.2s;
    clip-path: polygon(6px 0%, 100% 0%, calc(100% - 6px) 100%, 0% 100%);
  }
  .ticket-opt:hover, .ticket-opt.active {
    border-color: var(--fire); color: var(--fire);
    background: rgba(255,77,0,0.08);
    box-shadow: 0 0 16px rgba(255,77,0,0.15);
  }

  .buy-btn {
    width: 100%; background: var(--grad-main);
    color: #fff; border: none;
    padding: 20px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem; letter-spacing: 0.12em;
    cursor: pointer;
    clip-path: polygon(14px 0%, 100% 0%, calc(100% - 14px) 100%, 0% 100%);
    transition: all 0.3s;
    box-shadow: 0 8px 32px rgba(255,77,0,0.3);
    position: relative; overflow: hidden;
  }
  .buy-btn::after {
    content: ''; position: absolute; inset: 0;
    background: rgba(255,255,255,0.12);
    transform: translateX(-100%) skewX(-20deg);
    transition: transform 0.5s;
  }
  .buy-btn:hover { transform: translateY(-2px); box-shadow: 0 14px 40px rgba(255,77,0,0.45); }
  .buy-btn:hover::after { transform: translateX(200%) skewX(-20deg); }

  /* === PRIZE GRID === */
  .prizes-grid {
    position: relative; z-index: 1;
    padding: 0 48px 100px;
  }

  .grid-3 {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 2px; background: rgba(255,77,0,0.06);
  }

  .prize-card {
    background: rgba(18,6,36,0.8);
    padding: 40px; position: relative; overflow: hidden;
    transition: background 0.3s, transform 0.3s;
    cursor: pointer; border: 1px solid transparent;
    border-top: 2px solid transparent;
  }
  .prize-card:hover {
    background: #0d0d20;
    border-top-color: var(--fire);
    transform: translateY(-4px);
    z-index: 2;
    box-shadow: 0 20px 60px rgba(255,77,0,0.12);
  }

  .card-icon { font-size: 3rem; margin-bottom: 22px; display: block;
    filter: drop-shadow(0 0 16px rgba(255,77,0,0.4)); }
  .card-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem; letter-spacing: 0.04em;
    margin-bottom: 10px; color: var(--text);
  }
  .card-desc { color: var(--muted2); font-size: 0.82rem; line-height: 1.65; margin-bottom: 24px; }
  .card-footer { display: flex; align-items: flex-end; justify-content: space-between; }
  .card-price {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.5rem; letter-spacing: 0.03em;
    background: var(--grad-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .card-price small {
    font-family: 'Fira Code', monospace;
    font-size: 0.62rem; color: var(--muted);
    font-weight: 400; letter-spacing: 0.08em;
    display: block; -webkit-text-fill-color: var(--muted);
  }
  .card-slots { text-align: right; }
  .slots-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1rem;
    background: var(--grad-cool);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: block;
  }
  .slots-lbl { font-family: 'Fira Code', monospace; font-size: 0.6rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; }

  .progress-bar { width: 100%; height: 2px; background: rgba(255,255,255,0.06); margin-top: 20px; overflow: hidden; }
  .progress-fill { height: 100%; background: var(--grad-main); transition: width 1s ease; }

  .card-buy-btn {
    display: block; width: 100%; margin-top: 16px;
    background: transparent;
    border: 1px solid rgba(255,77,0,0.3);
    color: var(--muted2); padding: 12px;
    font-family: 'Bebas Neue', sans-serif; font-size: 0.85rem;
    letter-spacing: 0.1em; cursor: pointer;
    clip-path: polygon(6px 0%, 100% 0%, calc(100% - 6px) 100%, 0% 100%);
    transition: all 0.25s;
  }
  .card-buy-btn:hover {
    border-color: var(--fire); color: var(--fire);
    background: rgba(255,77,0,0.08);
    box-shadow: 0 0 24px rgba(255,77,0,0.15);
  }

  /* === HOW IT WORKS === */
  .how {
    position: relative; z-index: 1;
    padding: 100px 48px;
    background: rgba(12,4,28,0.75);
    border-top: 1px solid rgba(255,77,0,0.12);
    border-bottom: 1px solid rgba(255,77,0,0.12);
  }

  .steps {
    display: grid; grid-template-columns: repeat(4,1fr);
    gap: 2px; background: rgba(255,77,0,0.06); margin-top: 56px;
  }

  .step {
    background: var(--bg); padding: 44px 32px;
    position: relative; overflow: hidden;
    transition: background 0.3s;
  }
  .step:hover { background: rgba(18,6,36,0.8); }
  .step::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0;
    height: 3px; background: var(--grad-main);
    transform: scaleX(0); transition: transform 0.4s;
    transform-origin: left;
  }
  .step:hover::before { transform: scaleX(1); }

  .step-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 6rem; letter-spacing: -0.04em; line-height: 1;
    margin-bottom: 20px;
