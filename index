<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
  function goCheckout() {
    const el = document.getElementById('checkout');
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Countdown
  const targetDate = new Date('2026-01-21T18:00:00').getTime();
  function updateCountdown() {
    const now = new Date().getTime();
    const diff = targetDate - now;
    if (diff <= 0) {
      ['cd-days','cd-hours','cd-mins','cd-secs'].forEach(id => document.getElementById(id).textContent = '00');
      return;
    }
    document.getElementById('cd-days').textContent  = String(Math.floor(diff / 86400000)).padStart(2,'0');
    document.getElementById('cd-hours').textContent = String(Math.floor((diff % 86400000) / 3600000)).padStart(2,'0');
    document.getElementById('cd-mins').textContent  = String(Math.floor((diff % 3600000) / 60000)).padStart(2,'0');
    document.getElementById('cd-secs').textContent  = String(Math.floor((diff % 60000) / 1000)).padStart(2,'0');
  }
  updateCountdown();
  setInterval(updateCountdown, 1000);

  // Format CLP
  function fmt(n) { return '$' + n.toLocaleString('es-CL'); }

  // Ticket selector (hero)
  let featuredQty = 1;
  function selectTickets(el, qty) {
    document.querySelectorAll('.ticket-opt').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
    featuredQty = qty;
    document.querySelector('.buy-btn').textContent = 'COMPRAR ' + qty + ' TICKET' + (qty>1?'S':'') + ' — ' + fmt(4990 * qty);
  }
  function buyFeatured() {
    openModal('Viaje por Europa 21 días', 4990);
  }

  // Modal
  let currentUnitPrice = 4990;
  let currentQty = 1;

  function openModal(prizeName, unitPrice) {
    currentUnitPrice = unitPrice;
    currentQty = 1;
    const sel = document.getElementById('modalQtySelector');
    sel.innerHTML = '';
    const btn = document.createElement('button');
    btn.className = 'mqg-btn active';
    btn.style.gridColumn = '1 / -1';
    btn.innerHTML = '<span class="mqg-qty">x1 ticket</span><span class="mqg-price">' + fmt(unitPrice) + '</span><span class="mqg-badge">DISPONIBLE</span>';
    sel.appendChild(btn);
    document.getElementById('modalPrizeName').textContent = '// ' + prizeName;
    document.getElementById('summaryPrizeName').textContent = prizeName;
    document.getElementById('summaryQtyLabel').textContent = 'Tickets seleccionados (x1)';
    document.getElementById('webpayAmount').textContent = fmt(unitPrice);
    document.getElementById('modalFormView').style.display = '';
    document.getElementById('modalSuccess').style.display = 'none';
    document.getElementById('paymentModal').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    document.getElementById('paymentModal').classList.remove('open');
    document.body.style.overflow = '';
  }

  document.getElementById('paymentModal').addEventListener('click', function(e){
    if (e.target === this) closeModal();
  });

  function processPayment() {
    const name  = document.getElementById('buyerName').value.trim();
    const email = document.getElementById('buyerEmail').value.trim();
    if (!name)  { document.getElementById('buyerName').style.borderColor  = 'var(--fire)'; }
    if (!email) { document.getElementById('buyerEmail').style.borderColor = 'var(--fire)'; }
    if (!name || !email) return;
    document.getElementById('modalFormView').style.display = 'none';
    document.getElementById('modalSuccess').style.display = 'block';
    document.getElementById('successEmail').textContent = email;
    // Registrar en panel admin
    if (window.voltexRegistrarComprador) window.voltexRegistrarComprador(name, '', email, 'MercadoPago');
    else { try { const d=JSON.parse(localStorage.getItem('voltex_compradores')||'[]'); d.push({id:Date.now(),nombre:name,apellido:'',email,ticket:String(d.length+1).padStart(4,'0'),monto:4990,metodo:'MercadoPago',fecha:new Date().toLocaleDateString('es-CL',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'})}); localStorage.setItem('voltex_compradores',JSON.stringify(d)); } catch(e){} }
    const win1 = window.open('https://mpago.la/2UvKMw3', '_blank');
    if (!win1) { window.location.href = 'https://mpago.la/2UvKMw3'; }
  }

  // Checkout
  let currentPayMethod = 'mp';

  function selectCheckoutPrize(el, name, unit, total) {
    document.querySelectorAll('.checkout-prize-option').forEach(o => o.classList.remove('selected'));
    el.classList.add('selected');
    document.getElementById('checkoutSummaryName').textContent  = name;
    document.getElementById('checkoutSummaryUnit').textContent  = fmt(unit);
    document.getElementById('checkoutSummaryTotal').textContent = fmt(unit);
    document.getElementById('checkoutWebpayAmount').textContent = fmt(unit);
    document.getElementById('checkoutTransferAmount').textContent = fmt(unit);
  }

  function selectMethod(el, method) {
    document.querySelectorAll('.checkout-method').forEach(m => m.classList.remove('selected'));
    el.classList.add('selected');
    currentPayMethod = method;
    if (method === 'transfer') {
      document.getElementById('btnMercadoPago').style.display = 'none';
      document.getElementById('btnTransfer').style.display = 'block';
      document.getElementById('transferInfo').style.display = 'block';
      document.getElementById('coNote').textContent = 'Envía el comprobante a mabelvillegas565@gmail.com con tu nombre para recibir tu número.';
    } else {
      document.getElementById('btnMercadoPago').style.display = 'block';
      document.getElementById('btnTransfer').style.display = 'none';
      document.getElementById('transferInfo').style.display = 'none';
      document.getElementById('coNote').textContent = 'Serás redirigido al portal seguro de MercadoPago para completar el pago.';
    }
  }

  function checkoutPay() {
